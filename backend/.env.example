# RedTrace 后端环境变量样例。复制为 .env 后按实际部署填写；本文件不含任何真实密钥。

# ===== 生成与抽取 =====
# 大模型后端选择：online（在线接口）或 local（本地 GGUF 小模型）
LLM_BACKEND=
# 在线大模型服务的接口基址（openai 兼容地址），local 模式可留空
LLM_BASE_URL=
# 在线大模型 API 密钥。切勿提交真实密钥，.env 已在 .gitignore 中
LLM_API_KEY=
# 生成所用模型名（在线填模型 id，本地填 GGUF 文件路径）
LLM_MODEL=
# 混合思考模型开关。默认关闭：本项目为受约束抽取与生成，实测关闭不降低 JSON 合规性、
# 省掉全部 reasoning token（决策记录 007 第五节）。留空等价于 false。
# 注意这是供应商扩展参数，换供应商时需确认其是否接受（阶段八运行手册必查项）。
LLM_ENABLE_THINKING=

# ===== 检索引擎选择 =====
# 检索后端选择：local（自研管线：API 向量 + BM25 稀疏）或 ragflow（外部引擎适配器）
RETRIEVAL_BACKEND=
# RAGFlow 服务基址，仅 retrieval_backend=ragflow 时使用
RAGFLOW_BASE_URL=
# RAGFlow API 密钥。切勿提交真实密钥
RAGFLOW_API_KEY=

# ===== 向量化（决策记录 005 第七节定名、007 第二节实测） =====
# 三档必须都存在，付费云服务不得为唯一路径：api / local / stub
# stub = 不产出向量，检索退化为 BM25-only（无 key、离线、降级演练场景）
EMBEDDING_BACKEND=
# OpenAI 兼容 embeddings 的基址。留空即报错，不自动切换后端（与决策记录 002 同一纪律）
EMBEDDING_BASE_URL=
# 向量 API 密钥。可与 LLM_API_KEY 同值（同一供应商），但字段必须分组，便于逐组关闭演练
EMBEDDING_API_KEY=
# 定稿模型名（实测可用，输出 1024 维）
EMBEDDING_MODEL=
# 向量维度。dimensions 参数实测为 MRL 前缀截断（007 六-3），改维度仍判索引过期并重标阈值
EMBEDDING_DIM=
# 单次批量条数。服务端硬边界实测 25（官方文档称 20）；留空取默认 16
EMBEDDING_BATCH_SIZE=
EMBEDDING_TIMEOUT_S=
# 入库侧与查询侧的 text_type，两处都必须显式声明：
# 实测兼容层默认 query、原生端点默认 document，漏传会在返回 200 的情况下换掉向量空间（007 第四节）
EMBEDDING_TEXT_TYPE_DOCUMENT=
EMBEDDING_TEXT_TYPE_QUERY=
# 发送前逐条 token 预检线（服务端实测边界 131,072，此处留余量取 128,000）
EMBEDDING_MAX_TOKENS_PER_LINE=

# ===== 重排（决策记录 006 定路径、007 第二节实测） =====
# api / local_lexical（零 key 零网络）/ off
RERANK_BACKEND=
# 注意重排走的是 compatible-api 前缀，与 chat/embeddings 的 compatible-mode **不同**：
# https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_BASE_URL=
RERANK_API_KEY=
# 实测可用模型名：qwen3-rerank（定稿）与 qwen3.7-text-rerank；gte-rerank-v2 已下线禁用
RERANK_MODEL=
RERANK_TIMEOUT_S=
# 送重排的窗口宽度；服务端硬边界实测单次 ≤500 文档（官方口径一致）
RERANK_MAX_DOCS=
# 单文档 token 预检线；该部署服务端实测上下文 32,768（官方文档称 4,000，以部署为准）
RERANK_MAX_TOKENS_PER_DOC=

# ===== 数据 =====
# 数据目录（原始语料、解析产物、索引与 SQLite 主库的根路径）
DATA_DIR=
